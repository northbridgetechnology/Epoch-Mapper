{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epoch Game",
  "version": "0.1.0",
  "identifier": "com.epoch.game",
  "build": {
    "frontendDist": "../dist-player/web",
    "beforeBuildCommand": "npm run build:player"
  },
  "app": {
    "windows": [
      {
        "title": "Epoch Game",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
